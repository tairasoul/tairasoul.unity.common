<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition="$(IncludeAccessorFind) != 'false'">
    <DefineConstants>$(DefineConstants);ACCESSOR_INCLUDE_FINDFUNC</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(NativeMemory) == 'true'">
    <DefineConstants>$(DefineConstants);NATIVE_MEMORY</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="$(UnityEnvironment) == 'true'">
    <DefineConstants>$(DefineConstants);UNITY_ENVIRONMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../util/accessor.cs"/>
    <Compile Include="$(MSBuildThisFileDirectory)../util/action_queue.cs" Condition="$(IncludeActionQueue) != 'false'"/>
    <Compile Include="$(MSBuildThisFileDirectory)../util/assembly.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../util/casts.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../util/memory.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../util/unmanaged.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../util/unsafe.cs" />
  </ItemGroup>

  <ItemGroup>
    <RunAfterBuild Include="$(MSBuildThisFileDirectory)../weavers/CustomUnsafeWeaver/CustomUnsafeWeaver.csproj"/>
  </ItemGroup>
</Project>